# Copy this file to .env and adjust as needed. .env is gitignored -
# never commit real secrets. All values below are safe local-dev
# defaults; the app runs correctly even if .env is never created.

APP_NAME=InvoiceIQ
APP_ENV=development
LOG_LEVEL=INFO

# SQLite by default. To use PostgreSQL instead (no code changes needed):
# DATABASE_URL=postgresql://user:password@localhost:5432/invoiceiq
DATABASE_URL=sqlite:///./data/invoiceiq.db

# Local LLM (Ollama). Run `ollama pull phi3.5` once before starting the app.
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=phi3.5

# Optional: set GROQ_API_KEY to use Groq's free-tier hosted API instead of
# local Ollama (used automatically on the cloud deployment, where there's
# no CPU/RAM budget to run a local model at all). Get a free key at
# https://console.groq.com/keys - no credit card required. Leave unset for
# local dev; OLLAMA_MODEL above is ignored while this is set.
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile

# Signs login session cookies (HMAC-SHA256). Generate a real random
# value for anything beyond local development, e.g.:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-random-string

# Where uploaded invoice PDFs are saved, and the per-file size limit.
UPLOAD_DIR=./data/invoices
MAX_UPLOAD_SIZE_MB=10

DATA_DIR=./data
LOG_DIR=./logs
