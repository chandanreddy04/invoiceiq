# Copy this file to .env and adjust as needed. .env is gitignored -
# never commit real secrets. All values below are safe local-dev
# defaults; the app runs correctly even if .env is never created.

APP_NAME=InvoiceIQ
APP_ENV=development
LOG_LEVEL=INFO

# SQLite by default. To use PostgreSQL instead (no code changes needed):
# DATABASE_URL=postgresql://user:password@localhost:5432/invoiceiq
DATABASE_URL=sqlite:///./data/invoiceiq.db

# Local LLM (Ollama). Run `ollama pull phi3.5` once before starting the app.
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=phi3.5

# Optional: set GROQ_API_KEY to use Groq's free-tier hosted API instead of
# local Ollama (used automatically on the cloud deployment, where there's
# no CPU/RAM budget to run a local model at all). Get a free key at
# https://console.groq.com/keys - no credit card required. Leave unset for
# local dev; OLLAMA_MODEL above is ignored while this is set.
# GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-20b

# Optional: set all three to send real emails on approved drafts instead
# of the default simulated send (see Communication's model docstring -
# simulating delivery is intentional, this just opts into the real thing).
# For Gmail: use an App Password (myaccount.google.com/apppasswords), not
# your normal password - Google blocks plain-password SMTP login.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASSWORD=
# SMTP_FROM_EMAIL=you@gmail.com

# Optional: set to accept real online payments on outgoing invoices via
# a Stripe Checkout link, instead of "mark paid" being the only option.
# Get a key (test mode is fine to try it) at
# https://dashboard.stripe.com/apikeys - no charge to create one.
# STRIPE_SECRET_KEY=
# After creating a webhook in the Stripe dashboard (Developers -> Webhooks
# -> Add endpoint -> https://<your-domain>/stripe/webhook, event
# "checkout.session.completed"), paste its signing secret here - this is
# what proves a "payment completed" POST genuinely came from Stripe.
# STRIPE_WEBHOOK_SECRET=

# The public URL this app is reachable at - used to build the /pay/<token>
# link inside drafted emails, and to tell Stripe where to send a customer
# back to after paying. Leave unset locally; the pay-link line is simply
# omitted from drafted emails until this is set.
# APP_BASE_URL=https://invoiceiq-owo3.onrender.com

# Signs login session cookies (HMAC-SHA256). Generate a real random
# value for anything beyond local development, e.g.:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-random-string

# Where uploaded invoice PDFs are saved, and the per-file size limit.
UPLOAD_DIR=./data/invoices
MAX_UPLOAD_SIZE_MB=10

DATA_DIR=./data
LOG_DIR=./logs
